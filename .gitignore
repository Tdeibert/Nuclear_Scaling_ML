############################################################
# Nuclear_Scaling — .gitignore
#
# ALLOWLIST, not a denylist (introduced 2026-09-04; allow-list
# updated 2026-09-22 for the Code_Repository layout defined in
# Repository_Structure.json).
#
# Why: this folder is what gets pushed to
# github.com/Tdeibert/Nuclear_Scaling_ML. A denylist fails open:
# anything no rule matches gets committed. An allowlist fails
# closed: nothing is pushed unless it is named here.
#
# The repo holds SOURCE ONLY. Models/ (training) and _to_delete/
# live here but are ignored; data lives in /data/user/tdeibert.
############################################################

# ---- Deny everything at the top level ... ----
/*

# ---- ... then re-admit the source tree ----
!/.gitignore
!/README.md
!/CLAUDE.md
!/Repository_Structure.json
!/Code_Repository/

############################################################
# Belt and braces: file types that must never be committed,
# wherever they turn up inside the allowed tree.
############################################################

# --- Microscopy data ---
*.tif
*.tiff
*.ome.tif
*.nd2
*.czi
*.lif

# --- Arrays / tabular data ---
*.npy
*.npz
*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.xls

# --- Databases ---
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Models / checkpoints ---
*.keras
*.h5
*.hdf5
*.pt
*.pth
*.onnx

# --- Figures / documents ---
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.pptx
*.html

# --- Archives ---
*.zip
*.tar
*.gz

# --- Python / Jupyter cruft ---
__pycache__/
*.py[codz]
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/

# --- R cruft ---
.Rhistory
.RData
.Rproj.user/
*.Rproj

# --- HPC / logs ---
*.out
*.err
*.log
slurm-*.out

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Secrets ---
.env
.env.*
.git-credentials
*_token*
