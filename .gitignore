############################################################
# Nuclear_Scaling — .gitignore
#
# Rewritten 2026-09-04 as an ALLOWLIST rather than a
# denylist. The old 373-line denylist is still in git history:
#     git show HEAD:.gitignore
#
# Why: this folder is what gets pushed to
# github.com/Tdeibert/Nuclear_Scaling_ML, and it contains a 103 GB
# data tree. A denylist fails open — anything you add that no rule
# happens to match gets committed. An allowlist fails closed:
# nothing is pushed unless it is named here.
#
# The repo holds SOURCE ONLY: notebooks, scripts, database code,
# schema, configs, R. No data, no models, no figures, no docs.
############################################################

# ---- Deny everything at the top level ... ----
/*

# ---- ... then re-admit the source tree ----
!/.gitignore
!/README.md
!/CLAUDE.md
!/notebooks/
!/scripts/
!/src/
!/sql/
!/configs/
!/R/

############################################################
# Exclusions inside the allowed tree
############################################################

# In-flight rewrites — was `Refactors/` before the restructure,
# ignored then and ignored now.
/notebooks/refactors/

############################################################
# Belt and braces: file types that must never be committed,
# wherever they turn up inside the allowed tree.
############################################################

# --- Microscopy data ---
*.tif
*.tiff
*.ome.tif
*.nd2
*.czi
*.lif

# --- Arrays / tabular data ---
*.npy
*.npz
*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.xls

# --- Databases ---
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Models / checkpoints ---
*.keras
*.h5
*.hdf5
*.pt
*.pth
*.onnx

# --- Figures / documents ---
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.pptx
*.html

# --- Archives ---
*.zip
*.tar
*.gz

# --- Python / Jupyter cruft ---
__pycache__/
*.py[codz]
.ipynb_checkpoints/
*.egg-info/
build/
dist/
.venv/
venv/

# --- R cruft ---
.Rhistory
.RData
.Rproj.user/
*.Rproj

# --- HPC / logs ---
*.out
*.err
*.log
slurm-*.out

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Secrets ---
.env
.env.*
.git-credentials
*_token*
