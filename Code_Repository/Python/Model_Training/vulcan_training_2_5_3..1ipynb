   "source": [
    "## E4. Production segmentation subset diagnostic (read-only)\n",
    "\n",
    "Runs the promoted B5/B6 functions on the agreed t=2/t=9 droplets and five planes\n",
    "around each fitted droplet equator. Cyan is accepted, red is explicitly unknown,\n",
    "yellow is droplet support, and magenta is calculated NPC. No files are written.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "779f3350e101",
   "metadata": {
    "historical_output": true
   },
   "outputs": [],
   "source": [
    "if RUN_LEGACY_DIAGNOSTICS:\n",
    "    # ============================================================\n",
    "    # E4. Production segmentation subset diagnostic\n",
    "    # ============================================================\n",
    "    SEGMENTATION_SUBSET_IDS = {2: [0, 50, 100, 150, 200, 249],\n",
    "                               9: [0, 35, 68, 106, 144, 179]}\n",
    "    SEGMENTATION_SUBSET_OFFSETS = (-2, -1, 0, 1, 2)\n",
    "    \n",
    "    \n",
    "    def production_segmentation_subset(cfg=cfg):\n",
    "        \"\"\"Read-only visual/QC audit of production B5/B6 on a fixed subset.\"\"\"\n",
    "        hs = load_memmap_tiff(cfg.image_file)\n",
    "        rows = []\n",
    "        for t, ids in SEGMENTATION_SUBSET_IDS.items():\n",
    "            if t not in globals().get(\"E1_RESULTS\", {}):\n",
    "                raise RuntimeError(f\"E1_RESULTS[{t}] missing: run E1 first to reuse validated geometry\")\n",
    "            geometry = E1_RESULTS[t][1]\n",
    "            for did in ids:\n",
    "                if did not in geometry:\n",
    "                    print(f\"Skipping t={t}, d={did}: no accepted geometry\")\n",
    "                    continue\n",
    "                g = geometry[did]\n",
    "                z0 = int(round(g[\"z_eq\"]))\n",
    "                samples = []\n",
    "                for offset in SEGMENTATION_SUBSET_OFFSETS:\n",
    "                    z = z0 + offset\n",
    "                    if not 0 <= z < hs.shape[1]:\n",
    "                        continue\n",
    "                    fitted = z in g[\"prof\"] and z not in g[\"sphere_outliers\"]\n",
    "                    circle = g[\"prof\"][z] if fitted else predicted_circle(g, z, cfg)\n",
    "                    if circle is not None:\n",
    "                        samples.append((z, offset, circle, fitted))\n",
    "                if not samples:\n",
    "                    continue\n",
    "                x0 = max(0, int(np.floor(min(c[0]-c[2] for _, _, c, _ in samples))) - 12)\n",
    "                y0 = max(0, int(np.floor(min(c[1]-c[2] for _, _, c, _ in samples))) - 12)\n",
    "                x1 = min(hs.shape[-1], int(np.ceil(max(c[0]+c[2] for _, _, c, _ in samples))) + 13)\n",
    "                y1 = min(hs.shape[-2], int(np.ceil(max(c[1]+c[2] for _, _, c, _ in samples))) + 13)\n",
    "                prepared = []\n",
    "                for z, offset, (cx, cy, radius), fitted in samples:\n",
    "                    nls = read_crop(hs, t, z, cfg.nucleus_channel_idx, (y0, x0, y1, x1))\n",
    "                    npc = read_crop(hs, t, z, cfg.npc_channel_idx, (y0, x0, y1, x1))\n",
    "                    yy, xx = np.ogrid[:nls.shape[0], :nls.shape[1]]\n",
    "                    support_r = max(float(radius) - float(cfg.erosion_px), 1.0)\n",
    "                    support = ((xx-(cx-x0))**2 + (yy-(cy-y0))**2 <= support_r**2)\n",
    "                    nuc = detect_nucleus(nls, support, support_r, cfg)\n",
    "                    npc_result = detect_npc_on_envelope(npc, nuc, support, cfg)\n",
    "                    prepared.append((z, offset, nls, npc, support, fitted, nuc, npc_result))\n",
    "                    if not nuc[\"records\"]:\n",
    "                        rows.append(dict(t=t, droplet=did, z=z, offset=offset,\n",
    "                                         candidate=0, accepted=False,\n",
    "                                         reason=\"no_baseline_candidate\",\n",
    "                                         support_source=\"fitted\" if fitted else \"predicted\"))\n",
    "                    for record in nuc[\"records\"]:\n",
    "                        rows.append(dict(t=t, droplet=did, z=z, offset=offset,\n",
    "                                         support_source=\"fitted\" if fitted else \"predicted\",\n",
    "                                         **{k: v for k, v in record.items() if k != \"centroid\"}))\n",
    "                if not prepared:\n",
    "                    continue\n",
    "                nls_values = np.concatenate([p[2][p[4]] for p in prepared])\n",
    "                npc_values = np.concatenate([p[3][p[4]] for p in prepared])\n",
    "                nls_lo, nls_hi = np.percentile(nls_values, [1, 99.5])\n",
    "                npc_lo, npc_hi = np.percentile(npc_values, [1, 99.5])\n",
    "                fig, axes = plt.subplots(len(prepared), 5,\n",
    "                                         figsize=(20, 3.2*len(prepared)), squeeze=False)\n",
    "                for row_i, (z, offset, nls, npc, support, fitted, nuc, npc_result) in enumerate(prepared):\n",
    "                    panels = ((nls, \"Raw NLS\", nls_lo, nls_hi),\n",
    "                              (nls, \"Otsu baseline\", nls_lo, nls_hi),\n",
    "                              (nls, \"Accepted / unknown\", nls_lo, nls_hi),\n",
    "                              (npc, \"Raw NPC\", npc_lo, npc_hi),\n",
    "                              (npc, \"Calculated NPC\", npc_lo, npc_hi))\n",
    "                    for col, (image, title, lo, hi) in enumerate(panels):\n",
    "                        ax = axes[row_i, col]\n",
    "                        ax.imshow(image, cmap=\"gray\", vmin=lo, vmax=max(hi, lo+1))\n",
    "                        ax.contour(support, [0.5], colors=\"yellow\", linewidths=0.6,\n",
    "                                   linestyles=\"solid\" if fitted else \"dashed\")\n",
    "                        if title == \"Otsu baseline\" and nuc[\"baseline\"].any():\n",
    "                            ax.contour(nuc[\"baseline\"], [0.5], colors=\"cyan\", linewidths=1.0)\n",
    "                        elif title == \"Accepted / unknown\":\n",
    "                            if nuc[\"mask\"].any():\n",
    "                                ax.contour(nuc[\"mask\"], [0.5], colors=\"cyan\", linewidths=1.1)\n",
    "                            if nuc[\"unannotated\"].any():\n",
    "                                ax.contour(nuc[\"unannotated\"], [0.5], colors=\"red\", linewidths=1.1)\n",
    "                        elif title == \"Calculated NPC\":\n",
    "                            if npc_result[\"mask\"].any():\n",
    "                                ax.contour(npc_result[\"mask\"], [0.5], colors=\"magenta\", linewidths=1.1)\n",
    "                            if npc_result[\"unannotated\"].any():\n",
    "                                ax.contour(npc_result[\"unannotated\"], [0.5], colors=\"red\", linewidths=0.8)\n",
    "                        ax.set_title(f\"z={z} ({offset:+d}) | {title}\", fontsize=9)\n",
    "                        ax.axis(\"off\")\n",
    "                fig.suptitle(f\"T{t}, droplet {did}: cyan=NLS keep, red=unknown, magenta=NPC\")\n",
    "                plt.tight_layout(rect=[0, 0, 1, 0.97])\n",
    "                plt.show()\n",
    "                plt.close(fig)\n",
    "        result = pd.DataFrame(rows)\n",
    "        if not result.empty:\n",
    "            print(result.round(3).to_string(index=False))\n",
    "            if \"reason\" in result:\n",
    "                print(\"\\nCandidate outcomes:\")\n",
    "                print(result.groupby([\"t\", \"reason\"]).size().rename(\"n\").to_string())\n",
    "        return result\n",
    "    \n",
    "    \n",
    "    # Deliberately explicit: run after E1 has produced t=2 and t=9 geometry.\n",
    "    SEGMENTATION_SUBSET_RESULT = production_segmentation_subset()\n"
   ]
  }
 ],
